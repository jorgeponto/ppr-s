{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,

    "settings": {
        "appearanceTools": true,

        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },

        "color": {
            "custom": false,
            "defaultPalette": false,
            "defaultGradients": false,

            "background": true,
            "link": true,
            "text": true,

            "palette": [
                {
                    "slug": "light",
                    "color": "#F5F5F5",
                    "name": "Light"
                },
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "White"
                },
                {
                    "slug": "dark",
                    "color": "#202629",
                    "name": "Dark"
                },
                {
                    "slug": "primary",
                    "color": "#333399",
                    "name": "Primary"
                },
                {
                    "slug": "secondary",
                    "color": "#B1E4B2",
                    "name": "Secondary"
                },
                {
                    "slug": "info",
                    "color": "#0066CC",
                    "name": "Info"
                },
                {
                    "slug": "success",
                    "color": "#087F23",
                    "name": "Success"
                },
                {
                    "slug": "warning",
                    "color": "#8A4B00",
                    "name": "Warning"
                },
                {
                    "slug": "danger",
                    "color": "#B00020",
                    "name": "Danger"
                },
                {
                    "slug": "accent-1",
                    "color": "#4D4DB3",
                    "name": "Accent 1"
                },
                {
                    "slug": "accent-2",
                    "color": "#262673",
                    "name": "Accent 2"
                },
                {
                    "slug": "accent-3",
                    "color": "#6CCF78",
                    "name": "Accent 3"
                }
            ]
        },

        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },

        "spacing": {
            "customSpacingSize": false,
            "defaultSpacingSizes": false,

            "margin": true,
            "padding": true,
            "blockGap": true,

            "units": [
                "%",
                "px",
                "rem",
                "em",
                "vw",
                "vh"
            ],

            "spacingSizes": [
                {
                    "slug": "small",
                    "name": "Pequeno",
                    "size": "clamp(0.5rem, 0.25rem + 0.5vw, 0.75rem)"
                },
                {
                    "slug": "medium",
                    "name": "Médio",
                    "size": "clamp(1rem, 0.5rem + 1vw, 1.5rem)"
                },
                {
                    "slug": "large",
                    "name": "Grande",
                    "size": "clamp(1.5rem, 0.75rem + 1.5vw, 2.25rem)"
                }
            ]
        },

        "typography": {
            "customFontSize": false,
            "defaultFontSizes": false,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textAlign": true,
            "textDecoration": true,
            "textTransform": false,
            "dropCap": false,

            "fluid": {
                "minViewportWidth": "320px",
                "maxViewportWidth": "1280px",
                "minFontSize": "16px"
            },

            "fontFamilies": [
                {
                    "slug": "sans",
                    "name": "Sem serifas",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
                },
                {
                    "slug": "serif",
                    "name": "Com serifas",
                    "fontFamily": "Georgia, \"Times New Roman\", Times, serif"
                }
            ],

            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Pequeno",
                    "size": "0.875rem",
                    "fluid": false
                },
                {
                    "slug": "medium",
                    "name": "Médio",
                    "size": "1rem",
                    "fluid": false
                },
                {
                    "slug": "large",
                    "name": "Grande",
                    "size": "clamp(1.125rem, 1rem + 0.5vw, 1.375rem)",
                    "fluid": true
                },
                {
                    "slug": "x-large",
                    "name": "Muito grande",
                    "size": "clamp(1.5rem, 1.25rem + 1vw, 2rem)",
                    "fluid": true
                },
                {
                    "slug": "xx-large",
                    "name": "Extra grande",
                    "size": "clamp(2rem, 1.5rem + 2vw, 3rem)",
                    "fluid": true
                },
                {
                    "slug": "xxx-large",
                    "name": "Enorme",
                    "size": "clamp(2.5rem, 1.75rem + 3vw, 4rem)",
                    "fluid": true
                }
            ]
        }
    },

    "styles": {
        "color": {
            "background": "var:preset|color|white",
            "text": "var:preset|color|dark"
        },

        "spacing": {
            "blockGap": "var:preset|spacing|medium"
        },

        "typography": {
            "fontFamily": "var:preset|font-family|sans",
            "fontSize": "var:preset|font-size|medium",
            "lineHeight": "1.5"
        },

        "elements": {
            "link": {
                "color": {
                    "text": "var:preset|color|primary"
                },
                "typography": {
                    "textDecoration": "underline",
                    "fontWeight": "600"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|primary",
                        "background": "var:preset|color|secondary"
                    }
                }
            },

            "button": {                
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|small",
                        "right": "var:preset|spacing|medium",
                        "bottom": "var:preset|spacing|small",
                        "left": "var:preset|spacing|medium"
                    }
                },
                "typography": {
                    "fontWeight": "700"
                },
                ":focus": {
                    "outline": {
                        "color": "var:preset|color|dark",
                        "style": "solid",
                        "width": "3px",
                        "offset": "3px"
                    }
                }
            },

            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|serif",
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                },
                "color": {
                    "text": "var:preset|color|primary"
                }
            },

            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|xxx-large",
                    "lineHeight": "1.1"
                }
            },

            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|xx-large",
                    "lineHeight": "1.2"
                }
            },

            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-large",
                    "lineHeight": "1.25"
                }
            },

            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|large",
                    "lineHeight": "1.3"
                }
            },

            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "lineHeight": "1.4"
                }
            },

            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "lineHeight": "1.4"
                }
            }
        },

        "blocks": {
            "core/list": {
                "spacing": {
                    "padding": {
                        "left": "var:preset|spacing|large"
                    }
                }
            }
        }
    }
}