{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"slug": "box-info-secondary",
	"title": "Caixa de informação secundária",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|secondary",
			"text": "var:preset|color|dark"
		},
		"border": {
			"radius": "0.375rem"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|medium",
				"right": "var:preset|spacing|medium",
				"bottom": "var:preset|spacing|medium",
				"left": "var:preset|spacing|medium"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary",
					"background": "var:preset|color|secondary"
				},
				"typography": {
					"textDecoration": "underline",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary",
						"background": "var:preset|color|white"
					}
				}
			}
		}
	}
}